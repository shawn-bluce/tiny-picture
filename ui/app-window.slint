import { Button, CheckBox, ListView, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, ActivityIndicator, InfoBadge, FormLabel, Separator } from "widgets.slint";
import { LevelSlider } from "level-slider.slint";
import { PopUpButton } from "popup-button.slint";
import { FileRow, FileListHeader, FileItem, FileStatus } from "file-row.slint";

export { FileItem, FileStatus }

// Drop target. Shows the empty state or the file list, plus a highlight
// while files are dragged over the window.
component DropZone inherits Rectangle {
    in property <[FileItem]> files;
    in property <bool> drag-over;
    in property <bool> scanning;

    border-radius: Theme.radius-lg;
    border-width: root.drag-over ? 2px : 1px;
    border-color: root.drag-over ? Theme.accent : Theme.separator;
    background: Theme.surface;
    clip: true;
    accessible-role: list;
    accessible-label: "Images";

    animate border-color { duration: Theme.motion-fast; }

    // Empty state
    if root.files.length == 0: VerticalLayout {
        alignment: center;
        spacing: Theme.space-2;
        padding: Theme.space-6;

        HorizontalLayout {
            alignment: center;
            padding-bottom: Theme.space-1;
            Icon {
                size: Theme.icon-lg;
                source: @image-url("icons/images.svg");
                colorize: root.drag-over ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: root.drag-over ? "Release to Add" : "Drop Images or Folders Here";
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        if !root.scanning: Text {
            text: "JPG, PNG, WebP and GIF. Folders are scanned recursively.";
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.scanning: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            ActivityIndicator { }
            Text {
                text: "Scanning…";
                color: Theme.text-secondary;
            }
        }
    }

    // File list
    if root.files.length > 0: VerticalLayout {
        FileListHeader { }
        Separator { }
        ListView {
            for file[index] in root.files: FileRow {
                item: file;
                striped: Math.mod(index, 2) == 1;
            }
        }
    }

    // Drag-over highlight for a non-empty list
    if root.files.length > 0: Rectangle {
        background: Theme.accent;
        opacity: root.drag-over ? 0.08 : 0;

        animate opacity { duration: Theme.motion-fast; }
    }
    if root.files.length > 0 && root.drag-over: Rectangle {
        width: pill.preferred-width;
        height: pill.preferred-height;
        border-radius: self.height / 2;
        background: Theme.accent;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000040;

        pill := HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-4;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 6px;
            Icon {
                source: @image-url("icons/plus.svg");
                colorize: Theme.on-accent;
            }
            Text {
                text: "Release to Add";
                font-weight: 600;
                color: Theme.on-accent;
                vertical-alignment: center;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tiny Picture";
    preferred-width: 720px;
    preferred-height: 660px;
    min-width: 620px;
    min-height: 580px;
    background: Palette.background;
    default-font-size: Theme.font-body;

    // ---- Rust <-> UI data ----
    in property <[FileItem]> files;
    in property <bool> drag-over: false;
    in property <int> scanning: 0;
    in property <bool> busy: false;
    // Files that are waiting (or failed before) and will be processed by Compress
    in property <int> pending-count: 0;
    in property <float> progress: 0;
    in property <string> status: "No images";
    // File name prefix used when Replace is off
    in property <string> output-prefix;

    // Index into the compression levels; the slider snaps to whole numbers.
    in-out property <float> level: 2;
    in-out property <bool> powerful: false;
    in-out property <bool> replace: true;
    in-out property <int> convert-index: 0;

    private property <bool> idle: !root.busy && root.scanning == 0;

    // ---- UI -> Rust callbacks ----
    callback clear-files();
    callback start-compress();

    VerticalLayout {
        // ---- Content ----
        VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.space-4;
            padding-bottom: Theme.space-3;

            DropZone {
                files: root.files;
                drag-over: root.drag-over;
                scanning: root.scanning > 0;
            }
        }

        // ---- Settings ----
        GridLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-5;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-4;
            spacing-horizontal: Theme.space-3;
            spacing-vertical: Theme.space-3;

            Row {
                FormLabel { text: "Compression:"; }
                LevelSlider {
                    horizontal-stretch: 1;
                    names: ["Lossless", "Ultra", "High", "Medium", "Tiny"];
                    descriptions: [
                        "Smaller files with no loss in quality.",
                        "Visually identical to the original.",
                        "Excellent quality with good savings.",
                        "Balanced quality and file size.",
                        "Smallest files; quality loss may be visible.",
                    ];
                    enabled: root.idle;
                    value <=> root.level;
                }
            }

            Row {
                FormLabel { text: "Convert to:"; }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    PopUpButton {
                        label: "Convert to";
                        model: ["Original", "JPG", "PNG"];
                        enabled: root.idle;
                        current-index <=> root.convert-index;
                    }
                }
            }

            Row {
                FormLabel { text: "Options:"; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-1;

                    // Controls do not stretch: the cupertino CheckBox swaps its box
                    // element when toggled, which would otherwise re-distribute the row.
                    HorizontalLayout {
                        height: Theme.control-height;
                        alignment: start;
                        spacing: Theme.space-5;

                        CheckBox {
                            text: "Replace";
                            horizontal-stretch: 0;
                            enabled: root.idle;
                            checked <=> root.replace;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            CheckBox {
                                text: "Powerful";
                                horizontal-stretch: 0;
                                enabled: root.idle;
                                checked <=> root.powerful;
                                accessible-description: "Uses as many system resources as possible to finish the job faster.";
                            }
                            VerticalLayout {
                                alignment: center;
                                InfoBadge {
                                    tooltip: @markdown("Uses as many system resources as possible to finish the job faster.");
                                }
                            }
                        }
                    }

                    // Explains where output goes, without relying on hover
                    Text {
                        text: root.replace
                            ? "Original files are overwritten."
                            : "Compressed copies are saved next to the originals as \{root.output-prefix}<name>.";
                        font-size: Theme.font-caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Separator { }

        // ---- Action bar ----
        HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            padding-top: Theme.space-3;
            padding-bottom: Theme.space-3;
            spacing: Theme.space-2;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-1;

                Text {
                    text: root.status;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
                // Space is always reserved so the bar never changes height
                ProgressIndicator {
                    progress: root.progress;
                    opacity: root.busy || root.progress > 0 ? 1 : 0;
                }
            }

            VerticalLayout {
                alignment: center;
                Button {
                    text: "Clear";
                    enabled: root.idle && root.files.length > 0;
                    clicked => { root.clear-files(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.busy ? "Compressing…" : "Compress";
                    primary: true;
                    enabled: root.idle && root.pending-count > 0;
                    clicked => { root.start-compress(); }
                }
            }
        }
    }
}
